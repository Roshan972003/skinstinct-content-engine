# Skinstinct content bot — environment configuration.
#
# This runs as a Vercel Python function (app.py). Vercel functions don't
# read a .env file — set every one of these as a Vercel environment
# variable (encrypted, all of production/preview/development). Never
# commit a real .env.

# Required for live (non-mock) model calls. Without this, calls run in MOCK
# MODE and every output is clearly labeled as mocked.
GEMINI_API_KEY=your_gemini_api_key_here

# Prefer the `-latest` alias over a pinned version — Google rotates pinned
# model ids out from under you, and the alias doesn't break when that
# happens.
GEMINI_MODEL=gemini-flash-latest

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# The capture/review channel's chat id (a negative number starting -100).
# The bot ignores any update that isn't from this channel.
TELEGRAM_CHAT_ID=

# A second, separate channel's chat id. Only the final, clean approved
# copy gets posted here on Approve — nothing else (no drafts, no score,
# no buttons) ever shows up in this one.
TELEGRAM_PUBLISHED_CHAT_ID=

# Shared secret Telegram sends back on every webhook call, so the endpoint
# can reject requests that don't actually come from Telegram. Generate with:
#   openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=

# Settings -> API on the Supabase project dashboard. Used ONLY to bridge
# state between one stateless webhook call and the next (a voice note's
# transcript waiting for a format choice, a draft waiting for a decision)
# — rows are deleted as soon as they're resolved. Not a permanent archive.
SUPABASE_URL=https://your-project.supabase.co
# The `service_role` secret key — NOT the `anon`/publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# A GitHub personal access token with `repo` scope (classic) or
# Contents: Read and write (fine-grained), used to commit each approved
# post as a dated markdown file. This is the ONLY permanent record the
# app keeps.
GITHUB_TOKEN=
# Your GitHub username (owner of the archive repo).
GITHUB_OWNER=
# Name of the private repo to archive approved posts into. Created
# automatically on first approval if it doesn't already exist.
GITHUB_ARCHIVE_REPO=skinstinct-content-archive

# No key needed for Google News RSS — it's public. Nothing to configure
# here; listed for completeness.
