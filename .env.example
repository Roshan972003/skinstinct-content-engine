# Skinstinct content engine — environment configuration.
#
# For the local demo pipeline (pipeline.py), copy this file to ../.env (repo
# root) or adjust its load_dotenv path. For the live deployment (api/webhook.py,
# api/health.py on Vercel), set every one of these as a Vercel environment
# variable (encrypted, all of production/preview/development) instead —
# Vercel functions don't read a .env file. Never commit a real .env.

# Required for live (non-mock) model calls. Without this, calls run in MOCK
# MODE and every output is clearly labeled as mocked.
GEMINI_API_KEY=your_gemini_api_key_here

# Prefer the `-latest` alias over a pinned version — Google rotates pinned
# model ids out from under you, and the alias doesn't break when that
# happens. Confirmed reachable as of this build.
GEMINI_MODEL=gemini-flash-latest

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# The capture channel's chat id (a negative number starting -100). Used to
# ignore any update that isn't from this channel.
TELEGRAM_CHAT_ID=

# Shared secret Telegram sends back on every webhook call, so the endpoint
# can reject requests that don't actually come from Telegram. Generate with:
#   openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=

# Settings -> API on the Supabase project dashboard.
SUPABASE_URL=https://your-project.supabase.co
# The `service_role` secret key — NOT the `anon`/publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# No key needed for Google News RSS — it's public. Nothing to configure
# here; listed for completeness.
